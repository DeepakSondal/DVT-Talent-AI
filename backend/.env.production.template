# ============================================================
# DVT Talent AI — Production Environment Variables
# Copy this file to backend/.env on your VPS and fill in values
# NEVER commit this file to git!
# ============================================================

# ── App ─────────────────────────────────────────────────────
APP_NAME="DVT Talent AI"
APP_ENV=production
APP_BASE_URL=https://dvttalent.com
ALLOWED_ORIGINS=https://dvttalent.com,https://www.dvttalent.com,https://api.dvttalent.com

# ── Security (GENERATE NEW VALUES — never reuse local keys!) ─
# Run: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database (PostgreSQL) ────────────────────────────────────
# Run: openssl rand -base64 24 | tr -d '=+/' | head -c 24
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=dvt_talent
POSTGRES_USER=dvt_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://dvt_user:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/dvt_talent

# ── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ── AI Keys ──────────────────────────────────────────────────
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_API_KEY
SERPER_API_KEY=REPLACE_WITH_YOUR_SERPER_API_KEY

# ── Optional: OpenAI (if using GPT models) ───────────────────
OPENAI_API_KEY=

# ── Google OAuth (for "Sign in with Google") ─────────────────
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# ── Gmail Outreach (for automated email sending) ─────────────
GMAIL_CLIENT_ID=REPLACE_WITH_GMAIL_CLIENT_ID
GMAIL_CLIENT_SECRET=REPLACE_WITH_GMAIL_CLIENT_SECRET
GMAIL_REFRESH_TOKEN=REPLACE_WITH_GMAIL_REFRESH_TOKEN
GMAIL_SENDER_EMAIL=Deepak@dvttalent.com

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://dvttalent.com/api/v1
NEXT_PUBLIC_WS_URL=wss://dvttalent.com/api/v1/ws/pipeline-events

# ── ChromaDB ─────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── Stripe Billing (optional) ────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Sentry Error Tracking (optional) ─────────────────────────
SENTRY_DSN=
