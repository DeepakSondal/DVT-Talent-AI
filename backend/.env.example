# 🛰️ DVT TALENT AI — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to backend/.env and customize for your deployment environment

# ── APPLICATION CORE ────────────────────────────────────────────────────────
APP_NAME="DVT Talent AI"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=replace-with-a-cryptographically-secure-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── DATABASE & CONNECTION POOLING ──────────────────────────────────────────
# Local SQLite development default:
DATABASE_URL=sqlite+aiosqlite:///./dvt_talent.db
DATABASE_SYNC_URL=sqlite:///./dvt_talent.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dvt_talent
# DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/dvt_talent

# ── MESSAGE BROKER & TASK QUEUE (REDIS & CELERY) ───────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ── VECTOR STORAGE (CHROMADB & PINECONE) ───────────────────────────────────
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_COLLECTION_RESUMES=dvt_resumes
CHROMA_COLLECTION_JOBS=dvt_jobs
CHROMA_COLLECTION_COMPANIES=dvt_companies

PINECONE_API_KEY=
PINECONE_HOST=

# ── MULTI-PROVIDER AI AGENTS (PYDANTIC AI) ──────────────────────────────────
# Failover Priority: Anthropic > Groq > OpenAI > Kimi > DeepSeek

# Anthropic Claude (High-intelligence Reasoning, Discovery, Critic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Groq (Ultra-high speed candidate search & screening)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE=https://api.groq.com/openai/v1

# OpenAI (General purpose fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Kimi (Moonshot AI)
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-32k
KIMI_API_BASE=https://api.moonshot.cn/v1

# DeepSeek (Deep reasoning)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# ── SEARCH ENGINES & DATA ENRICHMENT ────────────────────────────────────────
SERPER_API_KEY=
GITHUB_TOKEN=
APIFY_API_KEY=

# ── DEFAULT SMTP & OUTREACH ────────────────────────────────────────────────
# Default system sender (tenants can override via Per-Tenant SMTP in Settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── BILLING & PAYMENTS (STRIPE) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ── OBSERVABILITY & MONITORING ─────────────────────────────────────────────
SENTRY_DSN=
