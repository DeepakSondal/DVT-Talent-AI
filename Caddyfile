{
    email admin@dvttalent.com
    # Automatic HTTPS via Let's Encrypt
}

# Snippet: shared config for frontend + API routing
(frontend_config) {
    # API Routes — must come before the catch-all frontend
    handle /api/* {
        reverse_proxy api:8000
    }

    # WebSocket
    handle /api/v1/ws/* {
        reverse_proxy api:8000
    }

    # Next.js Frontend — catch-all
    handle {
        reverse_proxy frontend:3000
    }

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Compression
    encode zstd gzip
}

# Redirect www → apex domain
www.dvttalent.com {
    redir https://dvttalent.com{uri} permanent
}

# Main app — Caddy auto-issues Let's Encrypt cert
dvttalent.com {
    import frontend_config
}

# Dedicated API subdomain (optional — for direct API access / mobile apps)
api.dvttalent.com {
    reverse_proxy api:8000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        -Server
    }

    encode zstd gzip
}

# Local development fallback (does NOT get HTTPS cert)
localhost {
    import frontend_config
}
