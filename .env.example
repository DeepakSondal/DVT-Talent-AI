# 🛰️ DVT TALENT AI — DOCKER COMPOSE / ROOT ENVIRONMENT TEMPLATE
# Copy to .env in repository root to run with docker-compose

# ── DATABASE (POSTGRESQL) ──────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_dev_password
POSTGRES_DB=dvt_talent
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_dev_password@postgres:5432/dvt_talent
DATABASE_SYNC_URL=postgresql://postgres:postgres_secure_dev_password@postgres:5432/dvt_talent

# ── REDIS & CACHE ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── VECTOR DATABASE ────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── SECURITY & SECRETS ─────────────────────────────────────────────────────
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars
APP_ENV=development

# ── AI PROVIDER KEYS ───────────────────────────────────────────────────────
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SERPER_API_KEY=

# ── FRONTEND ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/live
NEXT_PUBLIC_APP_NAME=DVT Talent AI
